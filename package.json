{
  "name": "skyfleet-logistics",
  "version": "1.0.0",
  "private": true,

  "scripts": {
    "dev": "next dev -p 3000",

    "server": "tsx server/index.ts",

    "dev:server": "npm run server",

    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",

    "build": "next build",
    "start": "next start -p 3000",

    "dev:safe": "powershell -ExecutionPolicy Bypass -Command \"taskkill /F /IM node.exe 2>$null; npx kill-port 3000 4000; npm run dev\"",

    "clean": "npx kill-port 3000 4000"
  },

  "dependencies": {
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",

    "firebase": "^12.13.0",
    "lucide-react": "^1.16.0",

    "ws": "^8.18.0",
    "redis": "^4.7.0"
  },

  "devDependencies": {
    "typescript": "6.0.3",
    "postcss": "^8.5.15",
    "autoprefixer": "^10.5.0",
    "tailwindcss": "^3.4.17",

    "tsx": "^4.19.0",
    "concurrently": "^9.0.0"
  }
}